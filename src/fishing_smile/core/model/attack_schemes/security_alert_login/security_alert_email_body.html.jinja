<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Unusual sign-in activity on your {{ attack.target.company }} account</title>
</head>
<body style="margin:0; padding:0; background-color:#f3f4f6; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; color:#111827; -webkit-font-smoothing:antialiased;">

  <div style="display:none; font-size:1px; color:#f3f4f6; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden;">
    We detected a sign-in to your {{ attack.target.company }} account from a new device. Review activity within 24 hours.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f4f6; padding:32px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 10px 30px rgba(15, 23, 42, 0.08), 0 2px 6px rgba(15, 23, 42, 0.04);">

          <tr>
            <td style="background:#b91c1c; background-image:linear-gradient(135deg, #dc2626 0%, #991b1b 100%); padding:28px 36px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td valign="middle" style="padding-right:16px;" width="56">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td width="52" height="52" align="center" valign="middle"
                            style="width:52px; height:52px; background:rgba(255,255,255,0.18); border-radius:14px; border:1px solid rgba(255,255,255,0.25);">
                          <span style="font-size:26px; line-height:1; color:#ffffff;">&#9888;</span>
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td valign="middle">
                    <div style="color:#ffffff; font-size:11px; font-weight:600; letter-spacing:1.2px; text-transform:uppercase; opacity:0.85;">
                      Security Alert
                    </div>
                    <div style="color:#ffffff; font-size:18px; font-weight:600; line-height:1.3; margin-top:4px;">
                      {{ attack.target.company }} Account Protection
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="background:#fef2f2; padding:14px 36px; border-bottom:1px solid #fee2e2;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td valign="middle" width="20" style="padding-right:10px;">
                    <span style="color:#dc2626; font-size:14px;">&#9201;</span>
                  </td>
                  <td valign="middle" style="color:#991b1b; font-size:13px; font-weight:600; line-height:1.4;">
                    Action required within 24 hours &middot; account may be locked after this period
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:36px 36px 8px 36px;">

              <h1 style="margin:0 0 10px 0; color:#0f172a; font-size:24px; font-weight:700; line-height:1.3; letter-spacing:-0.2px;">
                Unusual sign-in activity detected
              </h1>
              <p style="margin:0 0 24px 0; color:#6b7280; font-size:14px; line-height:1.5;">
                A new sign-in was detected on your {{ attack.target.company }} account.
                If this wasn&rsquo;t you, please secure your account now.
              </p>

              <p style="margin:0 0 18px 0; font-size:15px; line-height:1.6; color:#1f2937;">
                Hi <strong style="color:#0f172a;">{{ attack.target.name }}</strong>,
              </p>

              <p style="margin:0 0 24px 0; font-size:15px; line-height:1.7; color:#374151;">
                We noticed a sign-in to your <strong>{{ attack.target.company }}</strong> account
                from a device we don&rsquo;t recognize. For your security, please review this
                activity as soon as possible.
              </p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:12px; margin:0 0 28px 0;">
                <tr>
                  <td style="padding:8px 22px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

                      <tr>
                        <td width="36" valign="middle" style="padding:14px 0;">
                          <span style="font-size:18px; color:#6b7280;">&#128338;</span>
                        </td>
                        <td width="90" valign="middle" style="color:#6b7280; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; padding:14px 0;">
                          When
                        </td>
                        <td valign="middle" style="font-size:14px; color:#0f172a; font-weight:500; line-height:1.5; padding:14px 0;">
                          A few minutes ago
                        </td>
                      </tr>

                      <tr><td colspan="3" style="border-top:1px solid #e5e7eb; line-height:0; font-size:0;">&nbsp;</td></tr>

                      <tr>
                        <td width="36" valign="middle" style="padding:14px 0;">
                          <span style="font-size:18px; color:#6b7280;">&#127759;</span>
                        </td>
                        <td width="90" valign="middle" style="color:#6b7280; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; padding:14px 0;">
                          Where
                        </td>
                        <td valign="middle" style="font-size:14px; color:#0f172a; font-weight:500; line-height:1.5; padding:14px 0;">
                          Hanoi, Vietnam
                        </td>
                      </tr>

                      <tr><td colspan="3" style="border-top:1px solid #e5e7eb; line-height:0; font-size:0;">&nbsp;</td></tr>

                      <tr>
                        <td width="36" valign="middle" style="padding:14px 0;">
                          <span style="font-size:18px; color:#6b7280;">&#128187;</span>
                        </td>
                        <td width="90" valign="middle" style="color:#6b7280; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; padding:14px 0;">
                          Device
                        </td>
                        <td valign="middle" style="font-size:14px; color:#0f172a; font-weight:500; line-height:1.5; padding:14px 0;">
                          Windows 11 &middot; Chrome 138
                        </td>
                      </tr>

                      <tr><td colspan="3" style="border-top:1px solid #e5e7eb; line-height:0; font-size:0;">&nbsp;</td></tr>

                      <tr>
                        <td width="36" valign="middle" style="padding:14px 0;">
                          <span style="font-size:18px; color:#6b7280;">&#128231;</span>
                        </td>
                        <td width="90" valign="top" style="color:#6b7280; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; padding:14px 0;">
                          Account
                        </td>
                        <td valign="middle" style="font-size:14px; color:#0f172a; font-weight:500; line-height:1.5; padding:14px 0; word-break:break-all;">
                          {{ attack.target.name }}@{{ attack.target.company|lower }}.com
                        </td>
                      </tr>

                    </table>
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 28px 0;">
                <tr>
                  <td style="background:#ecfdf5; border:1px solid #a7f3d0; border-radius:10px; padding:14px 18px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td width="28" valign="top" style="font-size:16px; color:#059669;">&#10003;</td>
                        <td valign="top" style="font-size:13px; color:#065f46; line-height:1.6;">
                          <strong>If this was you</strong>, you can safely ignore this message.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr><td style="height:10px; line-height:10px; font-size:0;">&nbsp;</td></tr>
                <tr>
                  <td style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:14px 18px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td width="28" valign="top" style="font-size:16px; color:#dc2626;">&#10007;</td>
                        <td valign="top" style="font-size:13px; color:#991b1b; line-height:1.6;">
                          <strong>If this wasn&rsquo;t you</strong>, secure your account immediately
                          using the button below.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 18px 0;">
                <tr>
                  <td align="center">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="border-radius:10px; background:#dc2626; box-shadow:0 4px 12px rgba(220, 38, 38, 0.35);">
                          <a href="{{ templates.url }}"
                             style="display:inline-block; background:#dc2626; color:#ffffff; text-decoration:none;
                                    padding:15px 40px; border-radius:10px; font-size:15px; font-weight:600;
                                    letter-spacing:0.3px; mso-padding-alt:0;">
                            Review recent activity &rarr;
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 28px 0; font-size:12px; line-height:1.6; color:#9ca3af; text-align:center;">
                This secure link expires in <strong style="color:#6b7280;">24 hours</strong>.
              </p>

              <p style="margin:0 0 6px 0; font-size:14px; color:#374151; line-height:1.6;">
                Thank you for helping us keep {{ attack.target.company }} secure.
              </p>
              <p style="margin:0; font-size:14px; color:#0f172a; font-weight:600;">
                &mdash; {{ attack.target.company }} IT Security Team
              </p>

            </td>
          </tr>

          <tr>
            <td style="padding:0 36px 28px 36px;">
              <hr style="border:none; border-top:1px solid #e5e7eb; margin:8px 0 16px 0;">
              <p style="margin:0 0 6px 0; font-size:11px; color:#9ca3af; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">
                Trouble with the button?
              </p>
              <p style="margin:0; font-size:12px; color:#6b7280; line-height:1.6; word-break:break-all;">
                Copy and paste this URL into your browser:<br>
                <a href="{{ templates.url }}" style="color:#6b7280; text-decoration:underline;">{{ templates.url }}</a>
              </p>
            </td>
          </tr>

          <tr>
            <td style="background:#0f172a; padding:24px 36px; text-align:center;">
              <p style="margin:0 0 6px 0; color:#f8fafc; font-size:13px; font-weight:600;">
                {{ attack.target.company }} IT Security
              </p>
              <p style="margin:0 0 12px 0; color:#94a3b8; font-size:11px; line-height:1.6;">
                This is an automated security notification. Please do not reply to this message.<br>
                If you need help, contact your local IT support team.
              </p>
              <p style="margin:0; color:#64748b; font-size:10px; letter-spacing:0.3px;">
                &copy; {{ attack.target.company }} &middot; All rights reserved
              </p>
            </td>
          </tr>

        </table>

        <p style="margin:16px 0 0 0; color:#9ca3af; font-size:11px; line-height:1.5; max-width:600px; padding:0 12px;">
          You&rsquo;re receiving this email because a sign-in event was detected on your account.
        </p>

      </td>
    </tr>
  </table>
</body>
</html>
